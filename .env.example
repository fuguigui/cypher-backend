# Postgres connection string (Prisma format). For quick local dev with SQLite instead,
# change the datasource provider in prisma/schema.prisma to "sqlite" and use:
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@localhost:5432/cypher"

# Signing secret for session JWTs. Generate a real one before deploying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me"

# Optional: geocoding provider key (Mapbox, Google Maps, etc.) used by
# src/lib/geocode.js to turn a submitted address into lat/lng.
GEOCODING_API_KEY=""

PORT=4000
